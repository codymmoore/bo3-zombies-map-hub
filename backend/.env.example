# Copy to .env and fill in. All keys are read by app/config.py.

# "prod" refuses to start unless SECRET_KEY and INTERNAL_API_TOKEN are real
# (not the placeholders below, and long enough). "dev" only logs a warning.
ENV=dev

DATABASE_URL=postgresql+psycopg://hub:hub@localhost:5432/hub

# Random string of 32+ characters; signs the login cookie and OAuth state.
# e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Discord application (OAuth2 with the `identify` scope only).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback
# Bot token: used here only for REST membership/admin lookups.
# The bot needs the Server Members privileged intent enabled in the developer portal.
DISCORD_BOT_TOKEN=

# Shared secret between this API and the bot service (X-Internal-Token header), 16+ chars.
INTERNAL_API_TOKEN=change-me-too

# Optional: lets us resolve workshop author names.
STEAM_API_KEY=
# Black Ops III. Leave empty to accept items from any app.
STEAM_APP_ID=311210
